  "fps": 30,
  "font": "NotoSans.ttf",
  "voice": {
    "path": "silent_track.m4a",
    "lead": 0,
    "tail": 0,
    "contains_sfx": false
  },
  "captions": [
    {
      "start": 0,
      "end": 1.955,
      "text": "Đã bao giờ bạn bước vào một mối quan hệ"
    },
    {
      "start": 1.955,
      "end": 4.16,
      "text": "hoàn hảo đến mức bạn bắt đầu cảm thấy bất an"
    },
    {
      "start": 4.16,
      "end": 4.507,
      "text": "tột độ?"
    },
    {
      "start": 5.13,
      "end": 6.851,
      "text": "Đối phương đối xử với bạn dịu dàng,"
    },
    {
      "start": 6.851,
      "end": 8.817,
      "text": "lắng nghe bạn, bao dung mọi khuyết điểm."
    },
    {
      "start": 9.25,
      "end": 11.198,
      "text": "Nhưng thay vì tận hưởng sự bình yên đó,"
    },
    {
      "start": 11.198,
      "end": 13.396,
      "text": "bên trong bạn lại có một giọng nói thì thầm:"
    },
    {
      "start": 13.396,
      "end": 15.495,
      "text": "\"Chuyện này tốt đẹp quá mức bình thường..."
    },
    {
      "start": 15.495,
      "end": 17.345,
      "text": "chắc chắn sắp có điều tồi tệ xảy ra.\""
    },
    {
      "start": 17.97,
      "end": 21.434,
      "text": "Và rồi, bạn bắt đầu cáu gắt vô cớ, soi mói từng lỗi lầm nhỏ nhặt,"
    },
    {
      "start": 21.434,
      "end": 23.192,
      "text": "lạnh nhạt hoặc cố tình gây chiến."
    },
    {
      "start": 23.62,
      "end": 27.474,
      "text": "Để rồi khi đối phương kiệt sức và rời đi, bạn thở dài tự nhủ: \"Thấy chưa,"
    },
    {
      "start": 27.474,
      "end": 30.483,
      "text": "mình đã biết ngay là mọi thứ sẽ kết thúc như thế này mà.\""
    },
    {
      "start": 31.12,
      "end": 32.127,
      "text": "Hay trong sự nghiệp:"
    },
    {
      "start": 32.127,
      "end": 35.601,
      "text": "bạn nỗ lực nhiều năm để có được cơ hội thăng tiến hoặc một dự án lớn."
    },
    {
      "start": 36.03,
      "end": 38.803,
      "text": "Nhưng đúng vào thời khắc quyết định, bạn bắt đầu trì hoãn,"
    },
    {
      "start": 38.803,
      "end": 42.341,
      "text": "thức trắng đêm lướt điện thoại, đi trễ, hoặc nộp một bản kế hoạch cẩu thả."
    },
    {
      "start": 42.75,
      "end": 45.641,
      "text": "Bạn tự tay đánh sập cơ hội của chính mình ngay trước vạch đích."
    },
    {
      "start": 46.26,
      "end": 48.908,
      "text": "Nếu những kịch bản này nghe quen thuộc đến nhói lòng,"
    },
    {
      "start": 48.908,
      "end": 51.007,
      "text": "xin chào mừng bạn đến với kênh CÕI VÔ THỨC"
    },
    {
      "start": 51.63,
      "end": 55.147,
      "text": "Bạn không hề ngốc nghếch, bạn cũng không phải là người xấu tính hay bất tài."
    },
    {
      "start": 55.57,
      "end": 59.423,
      "text": "Những gì bạn đang trải qua là một nghịch lý tâm lý học sâu sắc mang tên:"
    },
    {
      "start": 59.423,
      "end": 61.35,
      "text": "Hành vi Tự Phá Hoại (Self-Sabotage)."
    },
    {
      "start": 61.97,
      "end": 65.528,
      "text": "Hôm nay, chúng ta sẽ cùng nhau bóc trần chiếc mặt nạ của cơ chế này:"
    },
    {
      "start": 65.528,
      "end": 69.295,
      "text": "Tại sao bộ não lại chọn cách tự hủy hoại khi cuộc sống đang êm đẹp nhất,"
    },
    {
      "start": 69.295,
      "end": 72.591,
      "text": "và làm thế nào để bạn thoát khỏi vòng lặp cay đắng này mãi mãi?"
    },
    {
      "start": 73.22,
      "end": 74.472,
      "text": "Trong cuộc sống hàng ngày,"
    },
    {
      "start": 74.472,
      "end": 77.796,
      "text": "hành vi tự phá hoại không xuất hiện dưới dạng một quyết định điên rồ,"
    },
    {
      "start": 77.796,
      "end": 81.36,
      "text": "mà nó ngụy trang vô cùng khéo léo dưới những thói quen tưởng chừng vô hại:"
    },
    {
      "start": 81.98,
      "end": 85.068,
      "text": "Thứ nhất: Sự trì hoãn mạn tính (Chronic Procrastination)."
    },
    {
      "start": 85.74,
      "end": 88.363,
      "text": "Bạn có một bài thuyết trình sống còn vào sáng thứ Hai."
    },
    {
      "start": 88.79,
      "end": 91.064,
      "text": "Bạn biết rõ mình cần chuẩn bị từ thứ Sáu."
    },
    {
      "start": 91.5,
      "end": 93.589,
      "text": "Nhưng thay vì ngồi vào bàn làm việc, bạn"
    },
    {
      "start": 93.589,
      "end": 95.574,
      "text": "bắt đầu dọn dẹp lại toàn bộ căn phòng,"
    },
    {
      "start": 95.574,
      "end": 98.824,
      "text": "sắp xếp lại tủ quần áo, và xem lại những video chẳng liên quan."
    },
    {
      "start": 99.26,
      "end": 100.728,
      "text": "Đây không phải là sự lười biếng."
    },
    {
      "start": 101.15,
      "end": 104.023,
      "text": "Tâm lý học chỉ ra rằng đây là một tấm khiên tự vệ:"
    },
    {
      "start": 104.023,
      "end": 108.218,
      "text": "Nếu bạn thất bại sau khi đã cố gắng 100%, điều đó chứng minh bạn kém cỏi."
    },
    {
      "start": 108.65,
      "end": 110.668,
      "text": "Nhưng nếu bạn thất bại vì \"chưa kịp chuẩn"
    },
    {
      "start": 110.668,
      "end": 112.587,
      "text": "bị\", lòng tự trọng của bạn vẫn an toàn."
    },
    {
      "start": 113.26,
      "end": 115.805,
      "text": "Thứ hai: Hội chứng \"Soi kính lúp\" trong tình cảm."
    },
    {
      "start": 116.47,
      "end": 119.319,
      "text": "Khi một người thực sự yêu thương và tôn trọng bạn xuất hiện,"
    },
    {
      "start": 119.319,
      "end": 121.028,
      "text": "bạn cảm thấy ngột ngạt và nhàm chán."
    },
    {
      "start": 121.5,
      "end": 125.258,
      "text": "Bạn vô thức tìm kiếm những đối tượng lạnh lùng, vô tâm hoặc đầy \"red flag\"."
    },
    {
      "start": 125.74,
      "end": 129.386,
      "text": "Và khi ở cạnh người tốt, bạn liên tục thử thách lòng kiên nhẫn của họ,"
    },
    {
      "start": 129.386,
      "end": 131.626,
      "text": "đẩy họ ra xa để xem họ có bỏ đi thật không."
    },
    {
      "start": 132.28,
      "end": 135.318,
      "text": "Thứ ba: Thói quen đóng vai nạn nhân hoặc tự rút lui sớm."
    },
    {
      "start": 135.95,
      "end": 139.66,
      "text": "Ngay khi một dự án hay một mối quan hệ bắt đầu yêu cầu sự cam kết cao hơn,"
    },
    {
      "start": 139.66,
      "end": 141.916,
      "text": "bạn đột ngột biến mất (ghosting), buông xuôi,"
    },
    {
      "start": 141.916,
      "end": 144.523,
      "text": "hoặc tự nhủ \"đằng nào mình cũng chẳng làm được đâu\"."
    },
    {
      "start": 145.15,
      "end": 146.033,
      "text": "Câu hỏi đặt ra là:"
    },
    {
      "start": 146.033,
      "end": 149.613,
      "text": "Nếu bản năng sinh tồn của con người là hướng tới hạnh phúc và thành công,"
    },
    {
      "start": 149.613,
      "end": 152.751,
      "text": "tại sao bộ não lại điều khiển chúng ta làm những điều ngược lại?"
    },
    {
      "start": 153.38,
      "end": 157.76,
      "text": "Khoa học tâm lý và thần kinh học đã giải mã cơ chế này qua 3 góc nhìn cốt lõi:"
    },
    {
      "start": 158.38,
      "end": 160.663,
      "text": "1. Vấn đề giới hạn trên (The Upper Limit"
    },
    {
      "start": 160.663,
      "end": 163.06,
      "text": "Problem) & Thuyết Bộ nhiệt nhiệt độ tâm lý"
    },
    {
      "start": 163.06,
      "end": 164.526,
      "text": "(Psychological Thermostat)"
    },
    {
      "start": 165.15,
      "end": 167.447,
      "text": "Tiến sĩ Gay Hendricks, tác giả cuốn sách nổi"
    },
    {
      "start": 167.447,
      "end": 169.43,
      "text": "tiếng The Big Leap, đã chỉ ra rằng mỗi"
    },
    {
      "start": 169.43,
      "end": 173.039,
      "text": "chúng ta đều có một \"bộ điều nhiệt nội tâm\" quy định mức độ hạnh phúc,"
    },
    {
      "start": 173.039,
      "end": 176.7,
      "text": "thành công và tình yêu thương mà chúng ta cho phép bản thân được hưởng."
    },
    {
      "start": 177.32,
      "end": 180.949,
      "text": "Nếu bạn lớn lên trong một môi trường đầy căng thẳng, chỉ trích hoặc bất ổn,"
    },
    {
      "start": 180.949,
      "end": 183.9,
      "text": "bộ điều nhiệt của bạn được cài đặt ở mức \"chịu đựng đau khổ\"."
    },
    {
      "start": 184.52,
      "end": 187.287,
      "text": "Khi cuộc sống thực tế trở nên quá thuận lợi và hạnh phúc,"
    },
    {
      "start": 187.287,
      "end": 189.471,
      "text": "nhiệt độ này vượt quá mức cài đặt quen thuộc."
    },
    {
      "start": 189.9,
      "end": 192.894,
      "text": "Bộ não không phân biệt được giữa \"hạnh phúc mới lạ\" và \"nguy hiểm\"."
    },
    {
      "start": 193.32,
      "end": 196.338,
      "text": "Ngay lập tức, hạch hạnh nhân (Amygdala) rung chuông báo động:"
    },
    {
      "start": 196.338,
      "end": 199.654,
      "text": "\"Cảnh báo! Trạng thái này không an toàn vì ta chưa từng trải qua!\"."
    },
    {
      "start": 200.09,
      "end": 202.836,
      "text": "Và để làm mát \"nhiệt độ\", bạn vô thức tạo ra xung đột,"
    },
    {
      "start": 202.836,
      "end": 204.843,
      "text": "làm hỏng công việc hoặc phá vỡ mối quan"
    },
    {
      "start": 204.843,
      "end": 207.005,
      "text": "hệ để kéo cảm xúc quay về vùng quen thuộc."
    },
    {
      "start": 207.67,
      "end": 211.141,
      "text": "2. Thuyết Gắn bó (Attachment Theory) và Nỗi sợ bị bỏ rơi"
    },
    {
      "start": 211.79,
      "end": 213.396,
      "text": "Những người mang kiểu gắn bó lo"
    },
    {
      "start": 213.396,
      "end": 215.676,
      "text": "âu (Anxious Attachment) hoặc gắn bó né tránh"
    },
    {
      "start": 215.676,
      "end": 218.057,
      "text": "(Avoidant Attachment) thường mang một niềm tin"
    },
    {
      "start": 218.057,
      "end": 219.869,
      "text": "tiềm thức sâu sắc: \"Mình không xứng"
    },
    {
      "start": 219.869,
      "end": 222.043,
      "text": "đáng được yêu thương\" hoặc \"Người khác sớm"
    },
    {
      "start": 222.043,
      "end": 223.959,
      "text": "muộn gì cũng sẽ làm tổn thương mình\"."
    },
    {
      "start": 224.59,
      "end": 227.474,
      "text": "Để giành lại quyền kiểm soát, tiềm thức của bạn ra lệnh:"
    },
    {
      "start": 227.474,
      "end": 229.454,
      "text": "\"Thà mình tự tay phá hủy nó trước, còn"
    },
    {
      "start": 229.454,
      "end": 231.747,
      "text": "hơn là ngồi chờ đối phương bỏ rơi mình.\" Cảm"
    },
    {
      "start": 231.747,
      "end": 233.884,
      "text": "giác đau đớn do chính mình gây ra dẫu sao"
    },
    {
      "start": 233.884,
      "end": 236.073,
      "text": "vẫn dễ chịu hơn là sự bất ngờ bị cự tuyệt."
    },
    {
      "start": 236.7,
      "end": 239.444,
      "text": "3. Sự bất hòa nhận thức (Cognitive Dissonance)"
    },
    {
      "start": 240.05,
      "end": 241.907,
      "text": "Nhà tâm lý học Leon Festinger đã chứng"
    },
    {
      "start": 241.907,
      "end": 243.96,
      "text": "minh rằng con người luôn khao khát sự nhất"
    },
    {
      "start": 243.96,
      "end": 246.373,
      "text": "quán giữa niềm tin bên trong và thực tế bên ngoài."
    },
    {
      "start": 247,
      "end": 249.947,
      "text": "Nếu sâu thẳm bên trong, bạn tin rằng mình là kẻ thất bại,"
    },
    {
      "start": 249.947,
      "end": 252.946,
      "text": "nhưng bên ngoài sếp lại khen thưởng và thăng chức cho bạn,"
    },
    {
      "start": 252.946,
      "end": 255.324,
      "text": "não bộ sẽ rơi vào trạng thái xung đột gay gắt."
    },
    {
      "start": 255.75,
      "end": 257.697,
      "text": "Để giải tỏa sự căng thẳng nhận thức này,"
    },
    {
      "start": 257.697,
      "end": 259.742,
      "text": "hành vi tự phá hoại xuất hiện như một công"
    },
    {
      "start": 259.742,
      "end": 263.494,
      "text": "cụ để điều chỉnh hiện thực bên ngoài cho khớp với niềm tin tiêu cực bên trong:"
    },
    {
      "start": 263.494,
      "end": 266.428,
      "text": "phá hỏng dự án để chứng minh niềm tin \"mình kém cỏi\" là đúng."
    },
    {
      "start": 267.06,
      "end": 268.226,
      "text": "Nếu không được nhận diện,"
    },
    {
      "start": 268.226,
      "end": 271.304,
      "text": "hành vi tự phá hoại sẽ giam cầm bạn trong một vòng lặp nghiệt ngã:"
    },
    {
      "start": 271.97,
      "end": 273.991,
      "text": "1. Bạn khao khát thành công / tình yêu."
    },
    {
      "start": 274.63,
      "end": 276.82,
      "text": "2. Bạn nỗ lực và đạt được một phần kết quả."
    },
    {
      "start": 277.44,
      "end": 281.494,
      "text": "3. Cảm giác lo âu, tội lỗi hoặc sợ hãi bùng phát vì vượt quá vùng an toàn."
    },
    {
      "start": 282.14,
      "end": 284.877,
      "text": "4. Bạn tự phá hoại (gây sự, trì hoãn, buông xuôi)."
    },
    {
      "start": 285.5,
      "end": 288.259,
      "text": "5. Mọi thứ sụp đổ, củng cố thêm niềm tin sai lệch:"
    },
    {
      "start": 288.259,
      "end": 290.907,
      "text": "\"Mình sinh ra đã không may mắn/không xứng đáng\"."
    },
    {
      "start": 291.55,
      "end": 294.517,
      "text": "Vòng lặp này không chỉ cướp đi những mối quan hệ chân thành,"
    },
    {
      "start": 294.517,
      "end": 297.038,
      "text": "những cơ hội sự nghiệp ngàn vàng, mà nguy hiểm hơn,"
    },
    {
      "start": 297.038,
      "end": 300.005,
      "text": "nó dần dần phá nát lòng tin của bạn vào chính bản thân mình."
    },
    {
      "start": 300.47,
      "end": 303.664,
      "text": "Bạn bắt đầu nghi ngờ mọi quyết định và sống trong sự phòng thủ cô độc."
    },
    {
      "start": 304.33,
      "end": 306.352,
      "text": "Làm thế nào để bạn chấm dứt thói quen tự"
    },
    {
      "start": 306.352,
      "end": 308.526,
      "text": "hủy hoại và can đảm đón nhận những điều tốt"
    },
    {
      "start": 308.526,
      "end": 308.726,
      "text": "đẹp?"
    },
    {
      "start": 309.15,
      "end": 312.353,
      "text": "Dưới đây là 3 bước can thiệp tâm lý hành vi đã được kiểm chứng:"
    },
    {
      "start": 312.98,
      "end": 314.935,
      "text": "Bước 1: Nâng ngưỡng \"Bộ điều nhiệt nội"
    },
    {
      "start": 314.935,
      "end": 316.89,
      "text": "tâm\" bằng phương pháp Dung nạp cảm xúc"
    },
    {
      "start": 316.89,
      "end": 317.854,
      "text": "(Somatic Tolerance)"
    },
    {
      "start": 318.48,
      "end": 321.851,
      "text": "Lần tới khi bạn cảm thấy một niềm vui lớn, một lời khen chân thành,"
    },
    {
      "start": 321.851,
      "end": 325.121,
      "text": "hay một khoảnh khắc bình yên bên người yêu, hãy dừng lại 30 giây."
    },
    {
      "start": 325.79,
      "end": 326.889,
      "text": "Hít một hơi thật sâu,"
    },
    {
      "start": 326.889,
      "end": 330.552,
      "text": "đặt tay lên ngực và cho phép cảm giác dễ chịu đó lan tỏa trong cơ thể."
    },
    {
      "start": 330.99,
      "end": 332.818,
      "text": "Khi cảm giác lo âu thì thầm \"sắp có"
    },
    {
      "start": 332.818,
      "end": 335.117,
      "text": "chuyện chẳng lành\", hãy tự nhủ với bản thân:"
    },
    {
      "start": 335.117,
      "end": 337.258,
      "text": "\"Mình đang an toàn. Cảm giác bình yên này"
    },
    {
      "start": 337.258,
      "end": 339.451,
      "text": "là bình thường, và mình xứng đáng được tận"
    },
    {
      "start": 339.451,
      "end": 341.331,
      "text": "hưởng nó mà không cần bất kỳ bi kịch"
    },
    {
      "start": 341.331,
      "end": 343.733,
      "text": "nào kèm theo.\" Bạn đang huấn luyện lại hệ thần"
    },
    {
      "start": 343.733,
      "end": 344.92,
      "text": "kinh quen với sự an ổn."
    },
    {
      "start": 345.59,
      "end": 348.811,
      "text": "Bước 2: Bắt bài \"Tiếng nói tự phá hoại\" (Catch the Saboteur)"
    },
    {
      "start": 349.48,
      "end": 352.405,
      "text": "Hãy ghi chép lại những khoảnh khắc bạn muốn gây sự hoặc trì hoãn."
    },
    {
      "start": 352.87,
      "end": 354.662,
      "text": "Hãy đặt tên cho tiếng nói tiêu cực đó."
    },
    {
      "start": 355.11,
      "end": 357.733,
      "text": "Ví dụ: \"À, lại là 'Kẻ Bất An' đang lên tiếng đấy à?\"."
    },
    {
      "start": 358.39,
      "end": 362.256,
      "text": "Tách biệt bản thân bạn ra khỏi suy nghĩ đó: Suy nghĩ không phải là sự thật,"
    },
    {
      "start": 362.256,
      "end": 365.04,
      "text": "suy nghĩ chỉ là phản xạ phòng vệ lỗi thời của quá khứ."
    },
    {
      "start": 365.46,
      "end": 367.202,
      "text": "Hãy tự hỏi một câu chất vấn sắc bén:"
    },
    {
      "start": 367.202,
      "end": 369.187,
      "text": "\"Hành động này của mình đang bảo vệ mình,"
    },
    {
      "start": 369.187,
      "end": 371.003,
      "text": "hay đang cướp đi tương lai của mình?\"."
    },
    {
      "start": 371.65,
      "end": 376.107,
      "text": "Bước 3: Giao tiếp chân thật về sự yếu đuối (Vulnerability Communication)"
    },
    {
      "start": 376.73,
      "end": 378.739,
      "text": "Thay vì biến nỗi sợ thành sự gây hấn hay"
    },
    {
      "start": 378.739,
      "end": 380.899,
      "text": "im lặng độc hại, hãy học cách nói thẳng cảm"
    },
    {
      "start": 380.899,
      "end": 383.777,
      "text": "xúc thật với người bạn đồng hành hoặc đồng nghiệp tin cậy."
    },
    {
      "start": 384.4,
      "end": 386.66,
      "text": "Hãy thử nói: \"Em/Anh nhận ra mình đang"
    },
    {
      "start": 386.66,
      "end": 389.158,
      "text": "có xu hướng muốn kiếm chuyện vì em/anh cảm"
    },
    {
      "start": 389.158,
      "end": 391.239,
      "text": "thấy bất an khi mọi thứ quá êm đẹp."
    },
    {
      "start": 391.239,
      "end": 393.974,
      "text": "Đây là vấn đề của em/anh, em/anh đang học cách"
    },
    {
      "start": 393.974,
      "end": 396.471,
      "text": "vượt qua và rất cần sự kiên nhẫn của bạn.\""
    },
    {
      "start": 396.471,
      "end": 398.849,
      "text": "Sự chân thành này sẽ tước đi toàn bộ sức"
    },
    {
      "start": 398.849,
      "end": 400.787,
      "text": "mạnh phá hoại của bóng ma tâm lý."
    },
    {
      "start": 401.42,
      "end": 403.281,
      "text": "Bạn thân mến, bạn đã sống sót qua những"
    },
    {
      "start": 403.281,
      "end": 405.286,
      "text": "ngày giông bão trong quá khứ không phải để"
    },
    {
      "start": 405.286,
      "end": 407.785,
      "text": "rồi tự biến hiện tại của mình thành một cơn bão khác."
    },
    {
      "start": 408.41,
      "end": 411.245,
      "text": "Bạn xứng đáng được yêu thương mà không cần phải nơm nớp lo sợ."
    },
    {
      "start": 411.71,
      "end": 414.298,
      "text": "Bạn xứng đáng thành công mà không cần phải cảm thấy tội lỗi."
    },
    {
      "start": 414.72,
      "end": 416.458,
      "text": "Hãy can đảm bước qua giới hạn cũ và"
    },
    {
      "start": 416.458,
      "end": 418.743,
      "text": "cho phép bản thân được hạnh phúc một cách trọn"
    },
    {
      "start": 418.743,
      "end": 418.939,
      "text": "vẹn."
    },
    {
      "start": 419.57,
      "end": 422.853,
      "text": "Nếu video hôm nay chạm đến câu chuyện của bạn, hãy nhấn nút Like,"
    },
    {
      "start": 422.853,
      "end": 424.796,
      "text": "chia sẻ nó cho một người đang cần lắng"
    },
    {
      "start": 424.796,
      "end": 426.995,
      "text": "nghe, và đừng quên nhấn Đăng ký kênh CÕI VÔ"
    },
    {
      "start": 426.995,
      "end": 429.091,
      "text": "THỨC cùng chuông thông báo để không bỏ lỡ"
    },
    {
      "start": 429.091,
      "end": 431.188,
      "text": "những hành trình thấu hiểu tâm lý sâu sắc"
    },
    {
      "start": 431.188,
      "end": 431.693,
      "text": "tiếp theo."
    },
    {
      "start": 432.32,
      "end": 436.082,
      "text": "Hãy để lại bình luận bên dưới: Bạn đã từng tự phá hoại điều gì trong đời,"
    },
    {
      "start": 436.082,
      "end": 437.783,
      "text": "và bạn đã nhận ra nó như thế nào?"
    },
    {
      "start": 438.22,
      "end": 441.14,
      "text": "Cảm ơn bạn đã lắng nghe, và hẹn gặp lại trong video tới!"
    }
  ],
